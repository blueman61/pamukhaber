# Kopyalayın: cp .env.example .env.local

# Veritabanı. Yerelde SQLite dosyası; canlıda Turso (libsql://...) adresi.
DATABASE_URL=file:./data/pamuk.db
# Yalnızca Turso için:
DATABASE_AUTH_TOKEN=

# Editör paneli (/admin) şifresi ve oturum imzalama anahtarı (en az 16 karakter, rastgele).
# Anahtar üretmek için: openssl rand -base64 32
ADMIN_PASSWORD=
AUTH_SECRET=

# Zamanlanmış RSS taraması (/api/cron/ingest) için gizli anahtar.
CRON_SECRET=

# Yapay zekâ taslak (Gemini). Anahtar: https://aistudio.google.com/apikey
# Boşsa editör formundaki AI düğmeleri gizlenir.
GEMINI_API_KEY=
# İsteğe bağlı model adı (varsayılan: gemini-2.5-flash)
GEMINI_MODEL=

# Aynı hikâyeye bu kadar farklı okurdan bildirim gelirse hikâye otomatik gizlenir (varsayılan 3).
REPORT_HIDE_THRESHOLD=3

# Herkese açık ayarlar
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "Destek ol" düğmesi (Patreon, Buy Me a Coffee, Kreosus vb.). Boşsa düğme gösterilmez.
NEXT_PUBLIC_SUPPORT_URL=
# Hakkında sayfasındaki iletişim adresi. Boşsa gösterilmez.
NEXT_PUBLIC_CONTACT_EMAIL=
